<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
    <type>org.netbeans.modules.ant.freeform</type>
    <configuration>
        <general-data xmlns="http://www.netbeans.org/ns/freeform-project/1">
            <name>Hotel Modules - Shared SQL Server</name>
            <folders>
                <source-folder><label>Source Packages</label><type>java</type><location>src</location></source-folder>
                <source-folder><label>Tests</label><type>java</type><location>test</location></source-folder>
                <build-folder><location>build</location></build-folder>
            </folders>
            <ide-actions>
                <action name="build"><target>jar</target></action>
                <action name="clean"><target>clean</target></action>
                <action name="rebuild"><target>rebuild</target></action>
                <action name="run"><target>run</target></action>
                <action name="test"><target>test</target></action>
            </ide-actions>
            <view>
                <items>
                    <source-folder style="packages"><location>src</location></source-folder>
                    <source-folder style="packages"><location>test</location></source-folder>
                    <source-folder style="tree"><label>SQL</label><location>sql</location></source-folder>
                    <source-folder style="tree"><label>Connection config</label><location>config</location></source-folder>
                    <source-file><location>build.xml</location></source-file>
                    <source-file><location>NETBEANS_SQL_CHUNG.md</location></source-file>
                </items>
                <context-menu>
                    <ide-action name="build"/><ide-action name="rebuild"/><ide-action name="run"/><ide-action name="test"/>
                    <action><label>Run shared DEMO</label><target>run-demo</target></action>
                    <action><label>Check database connection</label><target>check-db</target></action>
                </context-menu>
            </view>
        </general-data>
        <java-data xmlns="http://www.netbeans.org/ns/freeform-project-java/5">
            <compilation-unit>
                <package-root>src</package-root>
                <classpath mode="compile">lib/mssql-jdbc-13.2.1.jre11.jar</classpath>
                <built-to>build/classes</built-to><source-level>17</source-level>
            </compilation-unit>
            <compilation-unit>
                <package-root>test</package-root><unit-tests/>
                <classpath mode="compile">build/classes;lib/mssql-jdbc-13.2.1.jre11.jar</classpath>
                <built-to>build/test-classes</built-to><source-level>17</source-level>
            </compilation-unit>
        </java-data>
    </configuration>
</project>
